rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública/compartida para interoperabilidad con CartoDEA y Portal DEA.
    // Escritura restringida estrictamente a usuarios autenticados de DEA Data Bus.
    
    match /stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /levantamientos/{surveyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /reports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /samples/{sampleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /custom_templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /presence/{userId} {
      allow read, write: if request.auth != null;
    }

    match /app_activities/{activityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
